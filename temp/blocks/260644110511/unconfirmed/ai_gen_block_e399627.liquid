{% doc %}
  @prompt
    I need to add a block that adds in a meta field at the product variant level. can you create that and it will be a membership price. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-membership-price-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-membership-price__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_border %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-membership-price__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-membership-price__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-membership-price__empty-{{ ai_gen_id }} {
    font-size: 14px;
    color: #999;
    font-style: italic;
    padding: 8px 0;
  }
{% endstyle %}

<variant-membership-price-{{ ai_gen_id }}
  class="ai-membership-price-{{ ai_gen_id }}"
  data-metafield-namespace="{{ block.settings.metafield_namespace }}"
  data-metafield-key="{{ block.settings.metafield_key }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-membership-price__container-{{ ai_gen_id }}">
    {% if block.settings.label != blank %}
      <div class="ai-membership-price__label-{{ ai_gen_id }}">
        {{ block.settings.label }}
      </div>
    {% endif %}
    
    <div class="ai-membership-price__value-{{ ai_gen_id }}" data-membership-price>
      {% if product.selected_or_first_available_variant.metafields[block.settings.metafield_namespace][block.settings.metafield_key] != blank %}
        {{ product.selected_or_first_available_variant.metafields[block.settings.metafield_namespace][block.settings.metafield_key] | money }}
      {% else %}
        <span class="ai-membership-price__empty-{{ ai_gen_id }}">{{ block.settings.empty_state_text }}</span>
      {% endif %}
    </div>
  </div>
</variant-membership-price-{{ ai_gen_id }}>

<script>
  (function() {
    class VariantMembershipPrice{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.namespace = this.dataset.metafieldNamespace;
        this.key = this.dataset.metafieldKey;
      }

      connectedCallback() {
        this.priceElement = this.querySelector('[data-membership-price]');
        this.emptyStateText = '{{ block.settings.empty_state_text }}';
        
        const productForm = document.querySelector('product-form');
        if (productForm) {
          productForm.addEventListener('variant-change', this.handleVariantChange.bind(this));
        }
      }

      handleVariantChange(event) {
        const variant = event.detail.variant;
        
        if (!variant) {
          this.updatePrice(null);
          return;
        }

        const metafieldValue = variant.metafields && 
                               variant.metafields[this.namespace] && 
                               variant.metafields[this.namespace][this.key];

        this.updatePrice(metafieldValue);
      }

      updatePrice(value) {
        if (value) {
          const formattedPrice = this.formatMoney(value);
          this.priceElement.innerHTML = formattedPrice;
        } else {
          this.priceElement.innerHTML = '<span class="ai-membership-price__empty-{{ ai_gen_id }}">' + this.emptyStateText + '</span>';
        }
      }

      formatMoney(cents) {
        const money_format = '{{ shop.money_format }}';
        if (typeof cents === 'string') {
          cents = cents.replace('.', '');
        }
        let value = '';
        const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        const formatString = money_format;

        function formatWithDelimiters(number, precision, thousands, decimal) {
          thousands = thousands || ',';
          decimal = decimal || '.';

          if (isNaN(number) || number === null) {
            return 0;
          }

          number = (number / 100.0).toFixed(precision);

          const parts = number.split('.');
          const dollarsAmount = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
          const centsAmount = parts[1] ? decimal + parts[1] : '';

          return dollarsAmount + centsAmount;
        }

        switch (formatString.match(placeholderRegex)[1]) {
          case 'amount':
            value = formatWithDelimiters(cents, 2);
            break;
          case 'amount_no_decimals':
            value = formatWithDelimiters(cents, 0);
            break;
          case 'amount_with_comma_separator':
            value = formatWithDelimiters(cents, 2, '.', ',');
            break;
          case 'amount_no_decimals_with_comma_separator':
            value = formatWithDelimiters(cents, 0, '.', ',');
            break;
          case 'amount_no_decimals_with_space_separator':
            value = formatWithDelimiters(cents, 0, ' ');
            break;
          case 'amount_with_apostrophe_separator':
            value = formatWithDelimiters(cents, 2, "'");
            break;
        }

        return formatString.replace(placeholderRegex, value);
      }
    }

    customElements.define('variant-membership-price-{{ ai_gen_id }}', VariantMembershipPrice{{ ai_gen_id }});
  })();
</script>

