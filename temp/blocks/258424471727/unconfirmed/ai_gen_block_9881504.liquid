{% doc %}
  @prompt
    I'd really like to add in a Father's Day banner widget that gives you free shipping and free gift wrapping service if you choose to buy it for Father's Day. Can we also make sure this is in the style of RM Williams and the brand elements that exist already? 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fathers-day-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-fathers-day-banner__container-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    gap: 24px;
  }

  .ai-fathers-day-banner__content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-fathers-day-banner__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .ai-fathers-day-banner__subheading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
    opacity: 0.9;
  }

  .ai-fathers-day-banner__features-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 8px;
  }

  .ai-fathers-day-banner__feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-fathers-day-banner__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-fathers-day-banner__feature-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.feature_text_size }}px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-fathers-day-banner__cta-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-fathers-day-banner__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .ai-fathers-day-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-fathers-day-banner__container-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
      gap: 16px;
    }

    .ai-fathers-day-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-fathers-day-banner__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-fathers-day-banner__features-{{ ai_gen_id }} {
      gap: 12px;
    }

    .ai-fathers-day-banner__feature-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_text_size | times: 0.9 }}px;
    }

    .ai-fathers-day-banner__cta-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-fathers-day-banner__button-{{ ai_gen_id }} {
      width: 100%;
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-fathers-day-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-fathers-day-banner__container-{{ ai_gen_id }}">
    <div class="ai-fathers-day-banner__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-fathers-day-banner__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="ai-fathers-day-banner__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </p>
      {% endif %}

      <div class="ai-fathers-day-banner__features-{{ ai_gen_id }}">
        {% if block.settings.show_free_shipping %}
          <div class="ai-fathers-day-banner__feature-{{ ai_gen_id }}">
            <svg class="ai-fathers-day-banner__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span class="ai-fathers-day-banner__feature-text-{{ ai_gen_id }}">
              {{ block.settings.free_shipping_text }}
            </span>
          </div>
        {% endif %}

        {% if block.settings.show_gift_wrapping %}
          <div class="ai-fathers-day-banner__feature-{{ ai_gen_id }}">
            <svg class="ai-fathers-day-banner__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
            <span class="ai-fathers-day-banner__feature-text-{{ ai_gen_id }}">
              {{ block.settings.gift_wrapping_text }}
            </span>
          </div>
        {% endif %}
      </div>
    </div>

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <div class="ai-fathers-day-banner__cta-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="ai-fathers-day-banner__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Father's Day banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Father's Day Gift Guide"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Celebrate Dad with timeless Australian craftsmanship"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping",
      "label": "Show free shipping",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "free_shipping_text",
      "label": "Free shipping text",
      "default": "Free shipping"
    },
    {
      "type": "checkbox",
      "id": "show_gift_wrapping",
      "label": "Show gift wrapping",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "gift_wrapping_text",
      "label": "Gift wrapping text",
      "default": "Complimentary gift wrapping"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#e6dbc4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1f1007"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#1f1007"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "feature_text_size",
      "label": "Feature text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#1f1007"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#f8f4ee"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#1f1007"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#3e1707"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#f8f4ee"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border",
      "default": "#3e1707"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Father's Day banner"
    }
  ]
}
{% endschema %}